{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ferret-unbury",
  "main": "worker/src/index.ts",
  "compatibility_date": "2024-10-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./backend/app/static",
    "binding": "ASSETS"
  },
  // To attach Cloudflare D1, create a database in Cloudflare Dashboard -> Storage & Databases -> D1,
  // and paste its real UUID below:
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "file_archaeologist_db",
  //     "database_id": "<REAL-D1-DATABASE-UUID>"
  //   }
  // ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
