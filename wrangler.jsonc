{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ferret-unbury",
  "main": "worker/src/index.ts",
  "compatibility_date": "2024-10-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./backend/app/static",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "file_archaeologist_db",
      "database_id": "e1a6e63c-2573-4512-900b-4ee60fade4bb"
    }
  ],
  // R2 bucket can be uncommented once enabled in Cloudflare Dashboard:
  // "r2_buckets": [
  //   {
  //     "binding": "STORAGE_BUCKET",
  //     "bucket_name": "file-archaeologist-storage"
  //   }
  // ],
  "queues": {
    "producers": [
      {
        "binding": "INDEXING_QUEUE",
        "queue": "file-indexing-queue"
      }
    ],
    "consumers": [
      {
        "queue": "file-indexing-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "file-archaeologist-vectors"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "MAX_UPLOAD_BYTES": "52428800"
  }
}
