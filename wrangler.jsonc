{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ferret-unbury",
  "main": "worker/src/index.ts",
  "compatibility_date": "2024-10-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./backend/app/static",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "file_archaeologist_db",
      "database_id": "file-archaeologist-d1"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
