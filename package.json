{
  "name": "file-archaeologist",
  "version": "1.0.0",
  "private": true,
  "description": "File Archaeologist - Cloudflare Edge & Desktop Application",
  "scripts": {
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "deploy": "npm run build && wrangler deploy",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:worker": "wrangler dev",
    "d1:migrate:local": "wrangler d1 execute file_archaeologist_db --local --file=database/d1_schema.sql",
    "d1:migrate:remote": "wrangler d1 execute file_archaeologist_db --remote --file=database/d1_schema.sql",
    "test:worker": "node worker/test_endpoints.js"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  }
}
